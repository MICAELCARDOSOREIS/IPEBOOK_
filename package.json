{
  "name": "ipebook",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "apk:debug": "bash scripts/gerar-apk-debug.sh",
    "apk:debug:status": "bash scripts/gerar-apk-debug.sh status",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/setupNodeReactNative.cjs ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --require ./tests/setupNodeReactNative.cjs ./node_modules/vitest/vitest.mjs run --coverage",
    "check:architecture": "node scripts/verificar-arquitetura.mjs",
    "check:numbering": "node scripts/verificar-numeracao.mjs",
    "check:build-config": "node scripts/verificar-config-build.mjs",
    "test:sql": "node scripts/verificar-migracoes.mjs",
    "health:supabase": "node scripts/verificar-saude-supabase.mjs",
    "health:supabase:remote": "node scripts/verificar-migracoes-remotas.mjs",
    "db:seed": "node scripts/popular-catalogo-piripiri.mjs",
    "stats:beta": "node scripts/auditoria-metricas-beta.mjs",
    "validate": "npm run typecheck && npm run check:architecture && npm run check:numbering && npm run check:build-config && npm run test:sql && npm run test:coverage",
    "build:web": "expo export --platform web && node scripts/preparar-dist-web.mjs",
    "verify:release": "node scripts/verificar-release.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@rnmapbox/maps": "^10.3.16",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-screen-orientation": "~58.0.3",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.6",
    "mapbox-gl": "^2.15.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react-native": "^14.0.1",
    "@types/mapbox-gl": "^2.7.21",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "react-test-renderer": "^19.2.3",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
