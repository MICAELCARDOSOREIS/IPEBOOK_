{
  "name": "ipebook",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/setupNodeReactNative.cjs ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --require ./tests/setupNodeReactNative.cjs ./node_modules/vitest/vitest.mjs run --coverage",
    "check:architecture": "node scripts/verificar-arquitetura.mjs",
    "validate": "npm run typecheck && npm run check:architecture && npm run test:coverage",
    "build:web": "expo export --platform web",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "expo": "57.0.23",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
