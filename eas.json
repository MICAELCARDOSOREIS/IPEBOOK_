{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND": "supabase",
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "http://localhost:8081/redefinir-senha"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND": "supabase",
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "https://ipebook.app/redefinir-senha"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND": "supabase",
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "https://ipebook.app/redefinir-senha"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
