# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Use somente a chave publicável; nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
# Backend ativo: 'supabase' para persistência na nuvem ou 'memory' para testes locais voláteis
EXPO_PUBLIC_BACKEND=supabase
# URL permitida em Auth → URL Configuration do Supabase para o link de recuperação.
# Em desenvolvimento web local: http://localhost:8081/redefinir-senha (ou ipebook://redefinir-senha no Android)
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081/redefinir-senha
