{
  "expo": {
    "name": "Ipebook",
    "slug": "ipebook",
    "owner": "ipebook",
    "scheme": "ipebook",
    "version": "0.2.4",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFAF5",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFAF5"
    },
    "android": {
      "package": "com.ipebook.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FCEFCB",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ipebook.app",
      "buildNumber": "1",
      "runtimeVersion": { "policy": "fingerprint" },
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:ipebook.app"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      },
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false,
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp"],
        "NSCameraUsageDescription": "O IpêBook usa a câmera para ler o ISBN e QR Codes de entrega e tirar fotos de livros e do perfil.",
        "NSPhotoLibraryUsageDescription": "O IpêBook acessa suas fotos só quando você escolhe uma imagem para um anúncio ou para o seu perfil."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "themeColor": "#FCFAF5",
      "backgroundColor": "#FCFAF5",
      "description": "Marketplace comunitário de livros em Piripiri, PI (venda, troca e doação)"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FCFAF5",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O IpêBook usa a câmera para ler o ISBN e QR Codes de entrega e tirar fotos de livros e do perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacao-icone.png",
          "color": "#2B6334",
          "defaultChannel": "updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O IpêBook acessa suas fotos só quando você escolhe uma imagem para um anúncio ou para o seu perfil.",
          "cameraPermission": "O IpêBook usa a câmera para ler o ISBN e QR Codes de entrega e tirar fotos de livros e do perfil.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "ipebook",
          "organization": "usermicael"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": "production"
        }
      },
      "eas": {
        "projectId": "7593e188-168b-4282-87b9-74afae861981"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7593e188-168b-4282-87b9-74afae861981",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
