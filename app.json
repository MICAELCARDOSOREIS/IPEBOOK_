{
  "expo": {
    "name": "Ipebook",
    "slug": "ipebook",
    "owner": "ipebook",
    "scheme": "ipebook",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCFAF5",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFAF5"
    },
    "android": {
      "package": "com.ipebook.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FCEFCB",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ipebook.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "themeColor": "#2C5E45",
      "backgroundColor": "#FCFAF5",
      "description": "Marketplace comunitário de livros em Piripiri, PI (venda, troca e doação)"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O IpêBook usa a câmera para ler o ISBN ao anunciar um livro e para tirar a foto do seu perfil.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2C5E45"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O IpêBook acessa suas fotos só quando você escolhe uma imagem para o seu perfil.",
          "cameraPermission": "O IpêBook usa a câmera para ler o ISBN ao anunciar um livro e para tirar a foto do seu perfil.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7593e188-168b-4282-87b9-74afae861981"
      }
    }
  }
}
