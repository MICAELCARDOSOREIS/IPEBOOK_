#!/bin/sh
# Bloqueio de pushes diretos para a main / master e simulação completa do CI/CD antes do push

ZERO_OID="0000000000000000000000000000000000000000"
tem_push=0

while read local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo ""
    echo "❌ ERRO: Push direto para a branch 'main' está BLOQUEADO!"
    echo "👉 As alterações devem ser enviadas para 'develop' e integradas na 'main' somente via Pull Request aprovado."
    echo ""
    exit 1
  fi

  if [ -n "$local_oid" ] && [ "$local_oid" != "$ZERO_OID" ]; then
    tem_push=1
  fi
done

if [ "$tem_push" -eq 0 ]; then
  exit 0
fi

if [ "${IPEBOOK_SKIP_HOOKS:-0}" = "1" ]; then
  echo "⚠️  IPEBOOK_SKIP_HOOKS=1 ativo: pulando bateria completa do pre-push."
  exit 0
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "❌ ERRO: Node.js e npm são obrigatórios para validar o push localmente."
  exit 1
fi

if [ ! -f "scripts/rodar-ci-local.mjs" ]; then
  exit 0
fi

echo ""
echo "🚀 Executando bateria completa local (espelho do CI/CD do GitHub) antes do push..."
node scripts/rodar-ci-local.mjs --aviso-push </dev/null
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "❌ Push bloqueado: a validação local falhou antes de acionar o CI/CD no GitHub."
  echo "👉 Corrija os erros apontados acima (ou rode 'npm run ci:local' após ajustar) e tente novamente."
  echo ""
  exit "$status"
fi

exit 0
