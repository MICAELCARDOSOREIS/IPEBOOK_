#!/bin/sh
# Bloqueio de commits diretos na main / master e verificações rápidas locais antes do commit

branch="$(git symbolic-ref --short -q HEAD)"

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "❌ ERRO: Commits diretos na branch '$branch' estão BLOQUEADOS!"
  echo "👉 A branch '$branch' é reservada apenas para versões finais aprovadas."
  echo "👉 Mude para a branch 'develop' (ou crie uma feature branch) para continuar:"
  echo "   git checkout develop"
  echo ""
  exit 1
fi

if [ "${IPEBOOK_SKIP_HOOKS:-0}" = "1" ]; then
  echo "⚠️  IPEBOOK_SKIP_HOOKS=1 ativo: pulando verificação rápida do pre-commit."
  exit 0
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "❌ ERRO: Node.js e npm são obrigatórios para validar o commit localmente."
  exit 1
fi

if [ ! -f "scripts/rodar-ci-local.mjs" ]; then
  exit 0
fi

echo ""
echo "🔎 Executando verificações rápidas locais antes do commit (npm run ci:rapido)..."
node scripts/rodar-ci-local.mjs --rapido </dev/null
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "❌ Commit bloqueado: corrija as falhas acima antes de commitar."
  echo "👉 Dica: rode 'npm run ci:rapido' no terminal para revalidar rapidamente."
  echo ""
  exit "$status"
fi

exit 0
